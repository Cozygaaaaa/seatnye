{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd smart-home && npm install",
  "buildCommand": "cd smart-home && npm run build",
  "outputDirectory": "smart-home/build",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
